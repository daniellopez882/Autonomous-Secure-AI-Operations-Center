# Copy to .env and adjust. Never commit the result.

# ---- Application ------------------------------------------------------------
# development | testing | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false
BIND_HOST=127.0.0.1
PORT=8000

# Browser origins allowed to call the API (comma-separated).
# Empty in production means no browser may connect.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001

# Shared secret for the /ws/threat-feed WebSocket. Optional in development;
# /ready reports the service unready in production without it.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WS_AUTH_TOKEN=

# Seconds between simulation steps (0 in tests).
SIMULATION_STEP_SECONDS=1.5

# ---- LLM (declared; the shipped agents return canned findings) --------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- AWS (declared; not called by the simulation) ---------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Data stores (declared; not yet wired) ----------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/asoc
REDIS_URL=redis://localhost:6379/0
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=

# ---- Policy -----------------------------------------------------------------
OPA_URL=http://localhost:8181
VAULT_ADDR=http://localhost:8200
